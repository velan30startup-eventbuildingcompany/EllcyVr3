{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/(?:app|config|includes|sql|storage)(?:/.*)?",
      "status": 404
    },
    {
      "src": "/(?:README|LICENSE|package-lock|package|vercel)(?:\\.[^/]*)?",
      "status": 404
    },
    {
      "src": "/setup\\.php",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
