# Defense-in-depth: these are public-uploaded files. Never execute
# scripts from this directory, no matter what extension slips through.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|php\d|phtml|pl|py|cgi|sh|asp|aspx|exe)$">
    Require all denied
</FilesMatch>
Options -ExecCGI
AddHandler cgi-script .php .php3 .php4 .php5 .phtml .pl .py .cgi
